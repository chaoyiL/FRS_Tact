@@ -0,0 +1,100 @@
+"""Motion limits use fresh feedback, regardless of observation capture age."""
+import numpy as np
+import pytest
+from scipy.spatial.transform import Rotation
+from deploy_scripts import bimanual_rdp_online as online
+from deploy_scripts.rdp_action_reference import RDPActionReference
+from real_world.real_inference_util import get_real_umi_action
+from test_rdp_step_v3 import Client, Env, kwargs, action
+
+
+def pose(t, x=0., angle=0.):
+    out = {'timestamp': np.array([t])}
+    for i in range(2):
+        out[f'robot{i}_eef_pos'] = np.array([[x, 0., 0.]])
+        out[f'robot{i}_eef_rot_axis_angle'] = np.array([[0., 0., angle]])
+    return out
+
+
+def execute(wire, *, x=0., angle=0., deadline=False, reference=True, issued=True, schedule=True):
+    clock = [200.]
+    env = Env(clock)
+    env.get_action_reference_obs = lambda: pose(200., x, angle)
+    options = kwargs(env, clock)
+    options.update(converter=get_real_umi_action, schedule_from_receive=schedule)
+    if reference:
+        # Deliberately broader object: server configuration must remain authoritative.
+        options['action_reference'] = RDPActionReference(max_pos_delta=.5, max_rot_delta=2.)
+    if issued:
+        options['issued_reference_obs'] = pose(199.8)
+    if deadline:
+        options['issued_target_timestamp'] = 200.05
+    client = Client()
+    online.execute_rdp_action_chunk_and_publish_ack(client, 7, wire, **options)
+    return env, client.acks[0]
+
+
+@pytest.mark.parametrize('deadline', [False, True])
+def test_motion_since_capture_does_not_count_as_remaining_translation(deadline):
+    wire = action(); wire[0, [0, 10]] = .04
+    env, ack = execute(wire, x=.03, deadline=deadline)
+    assert ack['status'] == 'scheduled'
+    assert len(env.calls) == 1
+    np.testing.assert_allclose(env.calls[0]['actions'][0, [0, 7]], .04)
+
+
+@pytest.mark.parametrize('deadline', [False, True])
+def test_rotation_since_capture_does_not_count_as_remaining_rotation(deadline):
+    wire = action()
+    rot = Rotation.from_rotvec([0., 0., .6]).as_matrix()[:, :2].T.reshape(6)
+    wire[0, 3:9] = rot; wire[0, 13:19] = rot
+    env, ack = execute(wire, angle=.5, deadline=deadline)
+    assert ack['status'] == 'scheduled'
+    assert len(env.calls) == 1
+
+
+@pytest.mark.parametrize('kind', ['translation', 'rotation'])
+def test_configured_fresh_tracking_limit_cannot_be_bypassed_by_reference_object(kind):
+    wire = action()
+    if kind == 'translation':
+        wire[0, 0] = .04
+    else:
+        wire[0, 3:9] = Rotation.from_rotvec([0., 0., .6]).as_matrix()[:, :2].T.reshape(6)
+    env, ack = execute(wire)
+    assert ack['status'] == 'rejected'
+    assert 'tracking error' in ack['reason']
+    assert not env.calls
+
+
+@pytest.mark.parametrize('kind', ['zero', 'collinear', 'nan', 'gripper'])
+def test_observation_wire_still_rejects_invalid_structure(kind):
+    wire = action()
+    if kind == 'zero': wire[0, 3:6] = 0.
+    elif kind == 'collinear': wire[0, 6:9] = wire[0, 3:6]
+    elif kind == 'nan': wire[0, 0] = np.nan
+    else: wire[0, 9] = .2
+    env, ack = execute(wire)
+    assert ack['status'] == 'rejected'
+    assert not env.calls
+
+
+def test_observation_mode_requires_tracking_reference():
+    env, ack = execute(action(), reference=False)
+    assert ack['status'] == 'rejected'
+    assert 'tracking reference' in ack['reason']
+    assert not env.calls
+
+
+def test_observation_mode_requires_receive_scheduling():
+    env, ack = execute(action(), schedule=False)
+    assert ack['status'] == 'rejected'
+    assert 'receive' in ack['reason']
+    assert not env.calls
+
+
+def test_legacy_still_checks_raw_translation():
+    wire = action(); wire[0, 0] = .04
+    env, ack = execute(wire, x=.03, issued=False)
+    assert ack['status'] == 'rejected'
+    assert 'translation delta' in ack['reason']
+    assert not env.calls
