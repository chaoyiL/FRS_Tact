@@ -0,0 +1,102 @@
+"""CPU-only observation-reference baseline execution and negotiation."""
+import threading
+import numpy as np
+import pytest
+from scipy.spatial.transform import Rotation
+from client.robot_client import RobotClient, _LOW_LATENCY_EXECUTION_PROTOCOLS
+from deploy_scripts import bimanual_rdp_online as online
+from deploy_scripts.rdp_action_reference import RDPActionReference
+from deploy_scripts.rdp_step_protocol import snapshot_action_reference
+from real_world.real_inference_util import get_real_umi_action
+from test_rdp_step_v3 import Client, Env, kwargs, action
+from test_rdp_runtime_contract import valid_config
+
+
+def pose_obs(t, x):
+    obs = {'timestamp': np.array([t])}
+    for i in range(2):
+        obs[f'robot{i}_eef_pos'] = np.array([[x, 0., 0.]])
+        obs[f'robot{i}_eef_rot_axis_angle'] = np.array([[0., 0., .3]])
+    return obs
+
+
+@pytest.mark.parametrize('has_accepted', [False, True])
+def test_issued_pose_not_measured_or_accepted_is_conversion_reference(has_accepted):
+    clock = [200.]
+    env = Env(clock)
+    env.get_action_reference_obs = lambda: pose_obs(200., .012)
+    reference = RDPActionReference(max_pos_delta=.03, max_rot_delta=.5)
+    if has_accepted:
+        accepted = np.zeros((1, 14)); accepted[0, [0, 7]] = .022
+        accepted[0, [5, 12]] = .3
+        reference.commit(accepted)
+    issued = pose_obs(199.8, .005)
+    snapshot = snapshot_action_reference(issued)
+    # Camera/shared-memory buffers may change while the client predicts.
+    issued['robot0_eef_pos'][:] = .5
+    issued['robot1_eef_pos'][:] = .5
+    issued['timestamp'][:] = 999.
+    wire = action(); wire[0, [0, 10]] = .003
+    options = kwargs(env, clock)
+    options.update(converter=get_real_umi_action, action_reference=reference,
+                   issued_reference_obs=snapshot)
+    client = Client()
+    result = online.execute_rdp_action_chunk_and_publish_ack(client, 7, wire, **options)
+    expected = np.array([.005, 0., 0.]) + Rotation.from_rotvec([0.,0.,.3]).apply([.003,0.,0.])
+    np.testing.assert_allclose(result.fresh.absolute[0, :3], expected, atol=1e-8)
+    np.testing.assert_allclose(result.fresh.absolute[0, 7:10], expected, atol=1e-8)
+    assert client.acks[0]['reference_source'] == 'observation'
+    assert client.acks[0]['reference_timestamp'] == 199.8
+    assert client.acks[0]['target_timestamp'] == pytest.approx(200.05)
+    assert client.acks[0]['status'] == 'scheduled'
+    assert reference.source == ('accepted_target' if has_accepted else 'latest_measured')
+    if has_accepted:
+        np.testing.assert_array_equal(reference._accepted, accepted)
+
+
+def test_observation_mode_still_validates_tracking_against_fresh_measured():
+    clock=[200.]; env=Env(clock)
+    env.get_action_reference_obs=lambda:pose_obs(200., .8)
+    options=kwargs(env,clock)
+    options.update(converter=get_real_umi_action,
+                   action_reference=RDPActionReference(max_pos_delta=.03,max_rot_delta=.5),
+                   issued_reference_obs=snapshot_action_reference(pose_obs(199.8,0.)))
+    client=Client()
+    online.execute_rdp_action_chunk_and_publish_ack(client,7,action(),**options)
+    assert client.acks[0]['status']=='rejected'
+    assert 'tracking error' in client.acks[0]['reason']
+    assert not env.calls
+
+
+def test_rejects_reference_not_matching_issued_observation_timestamp():
+    clock=[200.];env=Env(clock)
+    options=kwargs(env,clock)
+    options['issued_reference_obs']=snapshot_action_reference(pose_obs(199.9,0.))
+    with pytest.raises(ValueError,match='match observation timestamp'):
+        online.execute_action_chunk(action(),**options)
+    assert not env.calls
+
+
+@pytest.mark.parametrize('protocol',['rdp_step_v3','rdp_observation_step_v1'])
+def test_negotiates_only_supported_rdp_protocols(protocol):
+    config=online.validate_rdp_config(valid_config(execution_protocol=protocol))
+    negotiated=online.validate_execution_config(config,execution_mode='rtc',
+        available_observation_keys=online.available_rdp_observation_keys('vitac',camera_count=2),
+        connection_generation=1,config_validator=online.validate_rdp_config,
+        step_protocol=config['execution_protocol'])
+    assert negotiated.protocol==protocol
+    assert protocol in _LOW_LATENCY_EXECUTION_PROTOCOLS
+
+
+def test_unknown_protocol_is_rejected():
+    with pytest.raises(ValueError,match='execution_protocol'):
+        online.validate_rdp_config(valid_config(execution_protocol='unknown'))
+
+
+def test_bridge_publishes_observation_reference_ack():
+    client=RobotClient.__new__(RobotClient)
+    client._condition=threading.Condition();client._stop_requested=False
+    client._consumed_action_generations={1:10};client._active_connection_generations={10};client._consumed_action_traces={}
+    client.publish_action_ack(1,status='scheduled',scheduled_count=1,target_timestamp=200.05,
+                              reason=None,reference_source='observation',reference_timestamp=199.8)
+    assert client._latest_action_ack['reference_source']=='observation'
