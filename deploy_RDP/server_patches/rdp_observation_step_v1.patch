+def snapshot_action_reference(observation):
+    """Own the pose associated with an issued observation, independent of buffers."""
+    keys = ["timestamp"]
+    for robot_idx in range(2):
+        keys.extend(f"robot{robot_idx}_{suffix}" for suffix in ("eef_pos", "eef_rot_axis_angle"))
+    return {key: np.asarray(observation[key])[-1:].copy() for key in keys}
