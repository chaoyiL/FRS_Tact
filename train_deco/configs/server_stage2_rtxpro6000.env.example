# 复制到 /workspace/secrets/deco-stage2.env 后填写；不要提交真实 token。
HF_TOKEN=
# 不使用 W&B 时设为 0；此时 WANDB_API_KEY 可以留空。
WANDB_ENABLED=1
WANDB_API_KEY=

WANDB_ENTITY=
WANDB_PROJECT=deco-stage2
WANDB_GROUP=deco-stage2-rtxpro6000
WANDB_MODE=online

HF_OUTPUT_INSERT_REPO=YOUR_HF_USERNAME/deco-stage2-insert
HF_OUTPUT_BREAD_REPO=YOUR_HF_USERNAME/deco-stage2-bread
HF_REPO_PRIVATE=1

# 物理 per-GPU batch；RTX PRO 6000 单卡默认按你的要求设为 1024。
BATCH_SIZE=1024
EPOCHS=50
SAVE_EVERY=10
LOG_EVERY_STEPS=10
CUDA_VISIBLE_DEVICES=0

# 留空时按 vCPU 的 75% 自动计算；16 vCPU -> 12 workers。
# WORKERS=12

# Insert 01~02 + Bread 01~03 + 权重首次完整下载的空间预检。
MIN_FREE_GB=90
HF_DOWNLOAD_WORKERS=8
